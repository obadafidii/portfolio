# Public: used by the browser to build Cloudinary delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_FOLDER=portfolio/blog

# Private: copy this value from Cloudinary's API Keys page. Never expose it
# through a NEXT_PUBLIC_ variable or commit it to source control.
CLOUDINARY_URL=cloudinary://api-key:api-secret@your-cloud-name
